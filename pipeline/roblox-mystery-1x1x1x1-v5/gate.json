    ],
    "match": true,
    "appearance_s": 7.08,
    "timing_gap_s": -0.46,
    "timing_verdict": "PASS"
   },
   {
    "index": 4,
    "start_s": 14.14,
    "end_s": 19.6,
    "text": "Then exploiters wrecked games and signed their chaos with his name, so every crash looked like proof.",
    "scene": 2,
    "title": "EVERY CRASH LOOKED LIKE PROOF",
    "title_element": "head-2",
    "shared_words": [
     "every",
     "crash",
     "looked",
