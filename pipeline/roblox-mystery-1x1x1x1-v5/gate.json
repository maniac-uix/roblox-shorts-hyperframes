    "timing_verdict": "PASS"
   },
   {
    "index": 3,
    "start_s": 7.54,
    "end_s": 13.36,
    "text": "It first appeared in 2007, in the description of a spooky Roblox hat called the Necrobloxicon.",
    "scene": 1,
    "title": "FIRST SEEN IN 2007 \u2014 THE NECROBLOXICON",
    "title_element": "head-1",
    "shared_words": [
     "first",
     "2007",
