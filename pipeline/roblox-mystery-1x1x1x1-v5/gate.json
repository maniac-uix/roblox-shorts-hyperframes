    "timing_verdict": "PASS"
   },
   {
    "index": 8,
    "start_s": 30.38,
    "end_s": 31.54,
    "text": "The hacker never existed.",
    "scene": 4,
    "title": "NEVER A HACKER.",
    "title_element": "head-4",
    "shared_words": [
     "never",
     "hacker"
    ],
    "match": true,
