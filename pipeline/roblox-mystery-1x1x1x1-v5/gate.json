     "proof"
    ],
    "match": true,
    "appearance_s": 13.36,
    "timing_gap_s": -0.78,
    "timing_verdict": "PASS"
   },
   {
    "index": 5,
    "start_s": 20.32,
    "end_s": 23.42,
    "text": "But in 2011, a Roblox admin revealed the truth.",
    "scene": 3,
    "title": "2011: THE TRUTH \u2014 A TEST ACCOUNT",
    "title_element": "head-3",
    "shared_words": [
     "2011",
     "truth"
    ],
    "match": true,
    "appearance_s": 19.6,
    "timing_gap_s": -0.72,
    "timing_verdict": "PASS"
   },
   {
    "index": 6,
    "start_s": 23.96,
    "end_s": 28.18,
    "text": "It was a test account, created by an admin named Shedletsky, for a story.",
    "scene": 3,
    "title": "2011: THE TRUTH \u2014 A TEST ACCOUNT",
    "title_element": "head-3",
    "shared_words": [
     "test",
     "account"
    ],
    "match": true,
    "appearance_s": 19.6,
    "timing_gap_s": -4.36,
    "timing_verdict": "PASS"
   },
   {
    "index": 7,
    "start_s": 28.86,
    "end_s": 29.76,
    "text": "He was never a hacker.",
    "scene": 4,
    "title": "NEVER A HACKER.",
    "title_element": "head-4",
    "shared_words": [
     "never",
     "hacker"
    ],
    "match": true,
    "appearance_s": 28.18,
