   {
    "index": 2,
    "start_s": 4.38,
    "end_s": 7.08,
    "text": "His name was 1x1x1x1.",
    "scene": 0,
    "title": "THE USERNAME WAS 1X1X1X1.",
    "title_element": "title-0",
    "shared_words": [
     "1x1x1x1"
