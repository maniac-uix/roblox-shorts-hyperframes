   },
   {
    "index": 5,
    "start_s": 20.04,
    "end_s": 22.98,
    "text": "But in 2011, a Roblox admin revealed the truth.",
    "scene": 3,
    "title": "A TEST ACCOUNT, NOT A HACKER",
    "title_element": "head-3",
    "shared_words": [],
    "match": false,
