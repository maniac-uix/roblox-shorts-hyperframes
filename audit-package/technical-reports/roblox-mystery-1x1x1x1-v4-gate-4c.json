   },
   {
    "index": 3,
    "start_s": 7.62,
    "end_s": 13.2,
    "text": "It first appeared in 2007, in the description of a spooky Roblox hat called the Necrobloxicon.",
    "scene": 1,
    "title": "A NAME IN A HAUNTED HAT",
