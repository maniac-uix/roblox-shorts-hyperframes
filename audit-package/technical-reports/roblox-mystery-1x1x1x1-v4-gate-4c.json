    "timing_verdict": "FAIL"
   },
   {
    "index": 6,
    "start_s": 23.49,
    "end_s": 27.54,
    "text": "It was a test account, created by an admin named Shedletsky, for a story.",
    "scene": 3,
    "title": "A TEST ACCOUNT, NOT A HACKER",
    "title_element": "head-3",
    "shared_words": [
